[Unit]
Description=AnubisProject Backend (uvicorn)
After=network.target

[Service]
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/backend/venv/bin/uvicorn main:app --reload --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
