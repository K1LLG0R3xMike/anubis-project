[Unit]
Description=AnubisProject Celery Worker (attack queue — execute_attack_run DAG orchestration)
After=network.target anubis-celery.service

[Service]
WorkingDirectory=__APP_DIR__/backend
ExecStart=__APP_DIR__/backend/venv/bin/celery -A celery_app worker --loglevel=info --concurrency=2 --queues=attack --hostname=attack@%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
