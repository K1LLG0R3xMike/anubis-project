# Base de datos PostgreSQL
DATABASE_URL=postgresql://admin:TU_PASSWORD@localhost:5432/ciber_db

# Gemini (proveedor por defecto)
GEMINI_API_KEY=TU_GEMINI_API_KEY
GEMINI_API_KEY_2=TU_GEMINI_API_KEY_FALLBACK   # opcional
GEMINI_MODEL=gemini-2.5-flash

# Proveedor de IA activo: gemini | claude | openai
AI_PROVIDER=gemini

# Opcional — otros proveedores
# ANTHROPIC_API_KEY=...
# CLAUDE_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o
